# Overlay on .env used only by scripts/serve-public.sh. Copy to .env.public
# (gitignored) and replace example.com with your domain.
WEB_APP_URL="https://studio.example.com"
CORS_ORIGINS="https://studio.example.com"
NEXT_PUBLIC_API_URL="https://api.example.com"
TRUST_PROXY="1"

# Close public sign-up once your own account exists (anyone could otherwise
# create a studio and store files on this Mac). Set "true" to allow sign-ups.
REGISTRATION_OPEN="false"

# Browsers reach storage through the media gateway on this hostname.
R2_PUBLIC_ENDPOINT="https://media.example.com"
R2_PUBLIC_URL="https://media.example.com/studio-os-media"

# Written by scripts/create-browser-key.sh:
# R2_PRESIGN_ACCESS_KEY_ID="studio-os-media-browser"
# R2_PRESIGN_SECRET_ACCESS_KEY="..."
