# Local Postgres container; use your hosted connection string for deployment
DATABASE_URL="postgresql://studio_os:studio_os@localhost:5433/studio_os"

# Auth — setup:local replaces this placeholder only when creating a new .env
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional error reporting. API and web server use SENTRY_DSN; the browser
# uses NEXT_PUBLIC_SENTRY_DSN. Set after creating Sentry projects.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Optional source-map upload during web builds:
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Daily reminders run at 9am in this IANA zone, with a catch-up check every
# five minutes. Set to the studio's zone until per-owner schedules exist.
NOTIFICATION_TIME_ZONE="America/Chicago"
JOB_CONCURRENCY="1" # per API replica; at most 2 (each photo can be 100MB)

# Cloudflare R2 (S3-compatible). Leave R2_ENDPOINT unset in production —
# it's only for pointing at a local MinIO/S3-compatible stand-in in dev.
R2_ENDPOINT="http://localhost:9000"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID="studio_os"
R2_SECRET_ACCESS_KEY="studio_os_minio"
R2_BUCKET_NAME="studio-os-media"
R2_PUBLIC_URL="http://localhost:9000/studio-os-media"
# Optional: sign browser upload/download links for a public storage address with
# a limited key (see "Serving clients from this Mac" in README.md). Set both keys or neither; R2_PUBLIC_ENDPOINT requires both.
R2_PUBLIC_ENDPOINT=""
R2_PRESIGN_ACCESS_KEY_ID=""
R2_PRESIGN_SECRET_ACCESS_KEY=""

# Set to "false" on a public deployment to refuse new sign-ups (existing accounts still log in).
# Unset keeps /register open.
REGISTRATION_OPEN=""

# Mux
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM="studio@example.com"

# Google Calendar sync
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# apps/web — set the real HTTPS API origin at build time for deployment
NEXT_PUBLIC_API_URL="http://localhost:3001"

# apps/api
PORT=3001
# Browser origins allowed to call the API. Comma-separate staging and
# production origins if needed. Required in production; use your real domain.
# CORS_ORIGINS="https://app.example.com"
CORS_ORIGINS="http://localhost:3000"
# Number of reverse-proxy hops in front of the API (usually 1 in production).
# Leave unset locally. Rate limiting and contract-signature IPs depend on it.
TRUST_PROXY=
WEB_APP_URL="http://localhost:3000"

# apps/mobile — localhost resolves to the host Mac from the iOS Simulator
# and the web preview; a physical device needs the host's LAN IP instead.
EXPO_PUBLIC_API_URL="http://localhost:3001"
