{
  "name": "studio-os",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:local": "node scripts/setup-local.mjs --start",
    "backup:local": "node scripts/backup-local.mjs",
    "restore:local": "node scripts/restore-local.mjs",
    "test:backup": "node --test scripts/local-backup.test.mjs",
    "test:gateway": "node --test scripts/media-gateway.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true,
    "sharp@0.35.4": true
  }
}
